<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="betaflight_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="x500">
      <pose>0 0 0.5 0 0 0</pose>
      <include merge="true">
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV/4</uri>
      </include>

      <plugin filename="libBetaflightPlugin.so" name="betaflight_gazebo::BetaFlightPlugin">
        <udp_port_motor_control>9002</udp_port_motor_control>
        <udp_port_sensor_data>9003</udp_port_sensor_data>
        <use_fc_lock_step>false</use_fc_lock_step>

        <control channel="0">
          <jointName>X3/rotor_0_joint</jointName>
          <useForce>1</useForce>
          <multiplier>8.54858e-06</multiplier> <offset>0</offset>
          <servo_min>1000</servo_min>
          <servo_max>2000</servo_max>
          <type>VELOCITY</type> <cmd_topic>/motor_0_cmd</cmd_topic>
        </control>

        <control channel="1">
          <jointName>X3/rotor_1_joint</jointName>
          <useForce>1</useForce>
          <multiplier>8.54858e-06</multiplier>
          <offset>0</offset>
          <servo_min>1000</servo_min>
          <servo_max>2000</servo_max>
          <type>VELOCITY</type>
          <cmd_topic>/motor_1_cmd</cmd_topic>
        </control>

        <control channel="2">
          <jointName>X3/rotor_2_joint</jointName>
          <useForce>1</useForce>
          <multiplier>8.54858e-06</multiplier>
          <offset>0</offset>
          <servo_min>1000</servo_min>
          <servo_max>2000</servo_max>
          <type>VELOCITY</type>
          <cmd_topic>/motor_2_cmd</cmd_topic>
        </control>

        <control channel="3">
          <jointName>X3/rotor_3_joint</jointName>
          <useForce>1</useForce>
          <multiplier>8.54858e-06</multiplier>
          <offset>0</offset>
          <servo_min>1000</servo_min>
          <servo_max>2000</servo_max>
          <type>VELOCITY</type>
          <cmd_topic>/motor_3_cmd</cmd_topic>
        </control>
      </plugin>

      <link name="imu_link">
        <inertial><mass>0.001</mass><inertia><ixx>1e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-05</iyy><iyz>0</iyz><izz>1e-05</izz></inertia></inertial>
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on><update_rate>250</update_rate><visualize>true</visualize><topic>imu</topic>
        </sensor>
      </link>
      <joint name="imu_joint" type="fixed">
        <child>imu_link</child>
        <parent>X3/base_link</parent>
      </joint>
    </model>
  </world>
</sdf>